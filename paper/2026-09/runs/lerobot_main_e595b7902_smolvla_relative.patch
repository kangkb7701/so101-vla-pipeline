@@ -0,0 +1,104 @@
+#!/usr/bin/env python
+
+"""Relative end-effector actions for robots whose observation state stays in joint space.
+
+The action vector is an end-effector pose ``[x, y, z, r1..r6, gripper]`` where ``r1..r6`` are the
+first two columns of the rotation matrix (6D rotation). The reference pose is computed from the
+current joint state with forward kinematics and subtracted element-wise, following the LeRobot
+relative-action convention (``relative = action - reference``); masked dimensions (gripper) stay absolute.
+
+Subclassing ``RelativeActionsProcessorStep`` keeps the paired ``AbsoluteActionsProcessorStep``,
+checkpoint re-linking and chunk-anchor binding working unchanged: the cached reference is simply the
+FK pose instead of the raw state.
+"""
+
+from dataclasses import dataclass, field
+from typing import Any
+
+import numpy as np
+import torch
+
+from lerobot.lerobot_types import EnvTransition, TransitionKey
+from lerobot.utils.constants import OBS_STATE
+
+from .pipeline import ProcessorStepRegistry
+from .relative_action_processor import RelativeActionsProcessorStep, to_relative_actions
+
+SO101_ARM_JOINTS = ["shoulder_pan", "shoulder_lift", "elbow_flex", "wrist_flex", "wrist_roll"]
+
+
+def pose_to_ee_vector(transform: np.ndarray) -> np.ndarray:
+    """4x4 homogeneous transform -> [x, y, z, r1..r6] with r = first two rotation columns."""
+    return np.concatenate([transform[:3, 3], transform[:3, 0], transform[:3, 1]])
+
+
+def ee_vector_to_pose(vec: np.ndarray) -> np.ndarray:
+    """[x, y, z, r1..r6] -> 4x4 transform, re-orthonormalizing the 6D rotation (Gram-Schmidt)."""
+    a1, a2 = vec[3:6], vec[6:9]
+    b1 = a1 / np.linalg.norm(a1)
+    a2 = a2 - np.dot(b1, a2) * b1
+    b2 = a2 / np.linalg.norm(a2)
+    transform = np.eye(4)
+    transform[:3, 0], transform[:3, 1], transform[:3, 2] = b1, b2, np.cross(b1, b2)
+    transform[:3, 3] = vec[:3]
+    return transform
+
+
+def joints_to_ee_reference(kinematics, state: np.ndarray, num_arm_joints: int) -> np.ndarray:
+    """(N, state_dim) joint states in degrees -> (N, 10) [ee pose (9), gripper state]."""
+    out = np.empty((state.shape[0], 10), dtype=np.float32)
+    for i, row in enumerate(state):
+        out[i, :9] = pose_to_ee_vector(kinematics.forward_kinematics(row[:num_arm_joints].astype(np.float64)))
+        out[i, 9] = row[-1]
+    return out
+
+
+@ProcessorStepRegistry.register("relative_ee_actions_processor")
+@dataclass
+class RelativeEEActionsProcessorStep(RelativeActionsProcessorStep):
+    """Relative EE actions whose reference is FK(current joint state)."""
+
+    urdf_path: str | None = None
+    target_frame: str = "gripper_frame_link"
+    joint_names: list[str] = field(default_factory=lambda: list(SO101_ARM_JOINTS))
+    _kinematics: Any = field(default=None, init=False, repr=False)
+
+    def _reference(self, state: torch.Tensor) -> torch.Tensor:
+        if self._kinematics is None:
+            from lerobot.model.kinematics import RobotKinematics
+
+            self._kinematics = RobotKinematics(
+                urdf_path=self.urdf_path, target_frame_name=self.target_frame, joint_names=self.joint_names
+            )
+        flat = state.detach().to("cpu", torch.float32).reshape(-1, state.shape[-1]).numpy()
+        ref = joints_to_ee_reference(self._kinematics, flat, len(self.joint_names))
+        return torch.from_numpy(ref).reshape(*state.shape[:-1], 10).to(state.device)
+
+    def __call__(self, transition: EnvTransition) -> EnvTransition:
+        observation = transition.get(TransitionKey.OBSERVATION, {})
+        state = observation.get(OBS_STATE) if observation else None
+
+        if state is not None and not self._chunk_in_flight():
+            self._last_state = self._reference(state)
+
+        if not self.enabled:
+            return transition
+
+        new_transition = transition.copy()
+        action = new_transition.get(TransitionKey.ACTION)
+        if action is None or state is None:
+            return new_transition
+        if not isinstance(action, torch.Tensor):
+            raise ValueError(f"RelativeEEActionsProcessorStep expects a tensor action, got {type(action)}")
+
+        mask = self._build_mask(action.shape[-1])
+        new_transition[TransitionKey.ACTION] = to_relative_actions(action, self._last_state, mask)
+        return new_transition
+
+    def get_config(self) -> dict[str, Any]:
+        return {
+            **super().get_config(),
+            "urdf_path": self.urdf_path,
+            "target_frame": self.target_frame,
+            "joint_names": self.joint_names,
+        }
