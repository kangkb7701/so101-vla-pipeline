+import numpy as np
+import genesis as gs
+
+# Genesis 초기화 (NVIDIA GPU 가속 사용)
+gs.init(backend=gs.cuda)
+
+# 씬(Scene) 설정
+scene = gs.Scene(
+    sim_options=gs.options.SimOptions(dt=0.01),
+    viewer_options=gs.options.ViewerOptions(
+        camera_pos=(3, -1, 1.5),
+        camera_lookat=(0.0, 0.0, 0.5),
+        camera_fov=30,
+    ),
+    show_viewer=True,
+)
+
+# 바닥 평면 추가
+plane = scene.add_entity(gs.morphs.Plane())
+
+# [1] URDF 로드 (SO-101 등 고정형 로봇)
+so101 = scene.add_entity(
+    gs.morphs.URDF(
+        file="/home/aivlab/SO-ARM100/Simulation/SO101/so101_new_calib.urdf",  # 나중에 이 부분을 SO-101 경로로 수정해
+        pos=(0, 0, 0),
+        euler=(0, 0, 0),
+        fixed=True,
+        scale=1.0,
+        merge_fixed_links=True,
+    )
+)
+
+# 씬 빌드 (컴파일)
+scene.build()
+
+# 1~3번 출력은 그대로 유지
+print("Links:", [link.name for link in so101.links])
+print("Joints:", [joint.name for joint in so101.joints])
+print("DoFs:", so101.n_dofs)
+
+# 4. 각 자유도별 가동 범위(Limit) 확인 (함수로 호출)
+# get_dofs_limit()은 (lower_limits, upper_limits) 튜플을 반환합니다.
+lower_limits, upper_limits = so101.get_dofs_limit()
+
+print("DoF lower limit:", lower_limits)
+print("DoF upper limit:", upper_limits)
+
+# 관절별로 예쁘게 보고 싶다면 아래처럼 작성해 보세요
+for i, joint in enumerate(so101.joints):
+    # 그리퍼 같은 Fixed 조인트는 DoF에서 제외될 수 있으니 인덱스 확인이 필요합니다
+    if i < len(lower_limits):
+        print(f"Joint [{joint.name}]: Limit = {lower_limits[i]:.2f} ~ {upper_limits[i]:.2f} (rad)")
+
+# 시뮬레이션 루프 (화면 확인용)
+while True:
+    scene.step()
